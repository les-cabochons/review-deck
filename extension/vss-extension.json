{
  "manifestVersion": 1,
  "id": "review-deck",
  "publisher": "Cabochonio",
  "version": "0.4.0",
  "name": "Review Deck",
  "description": "A pull request review page that groups changes by concern instead of by file, and a changelog of your tags and releases with their pipeline artifacts.",
  "public": false,
  "icons": {
    "default": "images/logo.png"
  },
  "content": {
    "details": {
      "path": "overview.md"
    }
  },
  "repository": {
    "type": "git",
    "uri": "https://github.com/les-cabochons/review-deck"
  },
  "links": {
    "getstarted": {
      "uri": "https://github.com/les-cabochons/review-deck#azure-devops-services-extension"
    },
    "repository": {
      "uri": "https://github.com/les-cabochons/review-deck"
    },
    "issues": {
      "uri": "https://github.com/les-cabochons/review-deck/issues"
    },
    "support": {
      "uri": "https://github.com/les-cabochons/review-deck/issues"
    }
  },
  "CustomerQnASupport": {
    "enablemarketplaceqna": true
  },
  "branding": {
    "color": "rgb(0, 0, 0)",
    "theme": "dark"
  },
  "tags": [
    "Pull Request",
    "Code Review",
    "Diff",
    "Stacked PRs",
    "Git",
    "Changelog",
    "Releases",
    "Conventional Commits"
  ],
  "categories": [
    "Azure Repos"
  ],
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "scopes": [
    "vso.code_write",
    "vso.build",
    "vso.work",
    "vso.project",
    "vso.hooks_write"
  ],
  "contributions": [
    {
      "id": "review-hub",
      "type": "ms.vss-web.hub",
      "description": "Review Deck: full-page pull request review with semantic grouping.",
      "targets": [
        "ms.vss-code-web.code-hub-group"
      ],
      "properties": {
        "name": "Deck",
        "uri": "dist/review.html",
        "icon": {
          "light": "images/deck-light.png",
          "dark": "images/deck-dark.png"
        },
        "order": 100
      }
    },
    {
      "id": "changelog-hub",
      "type": "ms.vss-web.hub",
      "description": "Changelog: the repository's tags and releases, with generated changelogs and pipeline artifacts.",
      "targets": [
        "ms.vss-code-web.code-hub-group"
      ],
      "properties": {
        "name": "Changelog",
        "uri": "dist/changelog.html",
        "icon": {
          "light": "images/changelog-light.png",
          "dark": "images/changelog-dark.png"
        },
        "order": 101
      }
    },
    {
      "id": "settings-hub",
      "type": "ms.vss-web.hub",
      "description": "Project settings for Review Deck: stacked PRs, auto-restack, AI group titles.",
      "targets": [
        "ms.vss-web.project-admin-hub-group"
      ],
      "properties": {
        "name": "Review Deck",
        "uri": "dist/settings.html",
        "order": 100
      }
    },
    {
      "id": "open-review-action",
      "type": "ms.vss-web.action",
      "description": "Opens the current pull request in Review Deck.",
      "targets": [
        "ms.vss-code-web.pull-request-action-menu"
      ],
      "properties": {
        "text": "Open in Review Deck",
        "title": "Open this pull request in Review Deck",
        "icon": "images/logo.png",
        "uri": "dist/action.html",
        "registeredObjectId": "open-review-action"
      }
    }
  ],
  "files": [
    {
      "path": "dist",
      "addressable": true
    },
    {
      "path": "images",
      "addressable": true
    },
    {
      "path": "assets/web-tree-sitter.wasm",
      "addressable": true,
      "contentType": "application/wasm"
    },
    {
      "path": "assets/tree-sitter-typescript.wasm",
      "addressable": true,
      "contentType": "application/wasm"
    },
    {
      "path": "assets/tree-sitter-tsx.wasm",
      "addressable": true,
      "contentType": "application/wasm"
    },
    {
      "path": "assets/tree-sitter-python.wasm",
      "addressable": true,
      "contentType": "application/wasm"
    },
    {
      "path": "assets/tree-sitter-go.wasm",
      "addressable": true,
      "contentType": "application/wasm"
    },
    {
      "path": "assets/tree-sitter-rust.wasm",
      "addressable": true,
      "contentType": "application/wasm"
    },
    {
      "path": "assets/tree-sitter-java.wasm",
      "addressable": true,
      "contentType": "application/wasm"
    },
    {
      "path": "assets/tree-sitter-c_sharp.wasm",
      "addressable": true,
      "contentType": "application/wasm"
    },
    {
      "path": "assets/tree-sitter-ruby.wasm",
      "addressable": true,
      "contentType": "application/wasm"
    },
    {
      "path": "assets/tree-sitter-php.wasm",
      "addressable": true,
      "contentType": "application/wasm"
    },
    {
      "path": "assets/tree-sitter-cpp.wasm",
      "addressable": true,
      "contentType": "application/wasm"
    }
  ]
}
