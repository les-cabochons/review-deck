{
  "name": "review-deck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prototype: group PR diff hunks by relatedness instead of by file.",
  "scripts": {
    "fixtures": "tsx scripts/build-fixtures.ts",
    "review": "tsx src/node/cli.ts",
    "eval": "tsx scripts/eval.ts",
    "bench": "tsx extension/tests/bench-pipeline.ts",
    "debug": "tsx scripts/debug-pr.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*/tests/*.test.ts",
    "lint:boundaries": "depcruise src extension/src extension/tests backend/src scripts",
    "ext:mock": "tsx scripts/build-ado-mock.ts && tsx scripts/build-ado-mock-list.ts",
    "ext:demo": "tsx scripts/build-demo-mock.ts",
    "ext:dev": "node extension/build.mjs --serve",
    "ext:build": "node extension/build.mjs",
    "ext:typecheck": "tsc --noEmit -p extension",
    "ext:test": "tsx --test extension/tests/*.test.ts",
    "ext:test:browser": "node scripts/build-write-test.mjs",
    "backend:typecheck": "tsc --noEmit -p backend",
    "backend:build": "node backend/build.mjs",
    "ext:package": "node extension/build.mjs && tfx extension create --root extension --manifest-globs vss-extension.json --output-path extension/"
  },
  "devDependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/functions": "^4.16.5",
    "@swc/core": "^1.16.18",
    "@types/node": "^24.19.2",
    "@types/react": "^16.14.70",
    "@types/react-dom": "^16.9.25",
    "dependency-cruiser": "^18.6.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.0",
    "tfx-cli": "^0.24.2",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@pierre/diffs": "1.5.2",
    "@pierre/trees": "1.0.0-beta.6",
    "@shikijs/langs": "4.5.0",
    "@huggingface/transformers": "^4.3.1",
    "azure-devops-extension-api": "^5.279.1",
    "azure-devops-extension-sdk": "^4.2.0",
    "azure-devops-ui": "^2.280.0",
    "diff": "^9.0.0",
    "diff2html": "^3.4.56",
    "dompurify": "^3.4.16",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "marked": "^18.1.0",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "shiki": "4.5.0",
    "tree-sitter-c-sharp": "^0.23.5",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.27.1"
  },
  "overrides": {
    "@pierre/diffs": { "react": "$react", "react-dom": "$react-dom" },
    "@pierre/trees": { "react": "$react", "react-dom": "$react-dom" },
    "@pierre/theming": { "react": "$react", "react-dom": "$react-dom" }
  }
}
